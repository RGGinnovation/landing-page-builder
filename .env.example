# Public site that hosts every partner page. Pages live at <this>/<slug>.
VITE_PUBLIC_SITE_URL=https://partners.revelationgoldgroup.com
# Where the bare root (/) sends visitors who are not on a connected partner domain.
VITE_ROOT_REDIRECT=https://revelationgoldgroup.com

# Set automatically by Lovable Cloud. Leave empty to run in local mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server secrets (Lovable Cloud provisions LOVABLE_API_KEY when Lovable AI is on).
LOVABLE_API_KEY=
# Optional: model for the "Regenerate" rewrite.
AI_MODEL=google/gemini-2.5-flash
